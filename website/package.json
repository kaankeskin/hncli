    "@types/node": "26.1.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.22.0",
    "eslint": "9.39.5",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prettier": "3.8.5",
    "svelte-check": "4.7.4",
    "svelte": "5.56.8",
    "tailwindcss": "4.3.3",
